# ──────────────────────────────────────────────
# Environment Configuration Template
# ──────────────────────────────────────────────
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 填入实际值
#   3. .env 已加入 .gitignore，不会提交到仓库
#
# 优先级：环境变量 > .env 文件 > 代码默认值
# ──────────────────────────────────────────────

# ── 应用基础 ──────────────────────────────────
APP_NAME=web3-airdrop-alpha-agent
APP_ENV=production
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8002
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=json

# ── Docker 部署端口 ───────────────────────────
# API 服务端口（映射到主机）
API_PORT=8002

# Nginx 端口（如果启用）
NGINX_PORT=80

# 时区
TZ=Asia/Shanghai

# ── 数据库 ────────────────────────────────────
# SQLite is the default when DATABASE_URL is unset.
DB_PATH=data/airdrop.db
# PostgreSQL is fully supported; the local test compose maps it to port 5433.
# DATABASE_URL=postgresql://airdrop:airdrop_test@127.0.0.1:5433/airdrop_test
POSTGRES_HOST_PORT=5433
POSTGRES_USER=airdrop
POSTGRES_PASSWORD=airdrop_test
POSTGRES_DB=airdrop_test

# ── API 鉴权 ──────────────────────────────────
# 空 = 无鉴权（本地默认）；设置后需 Header: X-API-Key 或 Authorization: Bearer
API_KEY=
# API_KEY_HEADER=X-API-Key

# ── LLM 配置 (ADR-001, ADR-012 分级使用) ────
# 默认关闭 LLM，仅规则引擎运行
# 设置 OPENAI_API_KEY 后自动启用 LLM 增强
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LLM_DAILY_BUDGET_USD=1.0
LLM_SEMAPHORE_SIZE=5
# v2.0 分级使用：仅 discovery_score ≥ 此阈值的项目启用 LLM，其余走规则引擎（ADR-012）
LLM_DISCOVERY_SCORE_THRESHOLD=0.7

# ── 采集质量阈值 (ADR-012) ───────────────────
# discovery_score ≥ 此阈值才进入分析管道（低于此值仅存信号，不触发分析）
DISCOVERY_SCORE_ANALYSIS_THRESHOLD=0.3
# 数据保留策略：raw_projects 保留天数 / project_signals 保留天数
RAW_PROJECTS_RETENTION_DAYS=30
PROJECT_SIGNALS_RETENTION_DAYS=90
COLLECTION_LOGS_RETENTION_DAYS=90

# ── 评分权重 (Σ=1.0，启动时断言) ─────────────
WEIGHT_AIRDROP_SIGNAL=0.18
WEIGHT_NARRATIVE_TIMING=0.15
WEIGHT_TEAM_REPUTATION=0.12
WEIGHT_RISK=0.12
WEIGHT_TOKENOMICS=0.10
WEIGHT_COMPETITION=0.10
WEIGHT_EXECUTION=0.13
WEIGHT_TRANSPARENCY=0.10

# ── 并发控制 (ADR-007) ───────────────────────
MAX_CONCURRENT_PROJECTS=10
# LLM_SEMAPHORE_SIZE 已在 LLM 配置中定义

# ── 调度配置 (ADR-005, ADR-012 双调度) ──────
SCHEDULER_ENABLED=true
# 分析调度器（既有）
CRON_EXPRESSION=0 8 * * *
TIMEZONE=UTC

# 采集调度器（v2.0，ADR-012）
COLLECTION_SCHEDULER_ENABLED=true
# 采集成功后是否立即跑分析队列（默认 false；true 时 trigger/cron 采集后自动 /run）
COLLECTION_AUTO_RUN_ENABLED=false
# 单次分析从 raw_projects 取的最大条数
ANALYSIS_RUN_LIMIT=100
# 各源独立 cron，见 DATA_SOURCE_STRATEGY.md §双调度模型
DEFILLAMA_CRON=0 8 * * *
GITHUB_CRON=30 8 * * *
COINGECKO_CRON=0 9 * * *
TWITTER_KOL_CRON=0 * * * *
TWITTER_KEYWORD_CRON=*/15 * * * *
ETHERSCAN_CRON=0 */6 * * *
GALXE_CRON=0 10 * * *
LAYER3_CRON=30 10 * * *

# ── 外部数据源 ────────────────────────────────
# DefiLlama（P0，免费）
DEFILLAMA_ENABLED=true
DEFILLAMA_BASE_URL=https://api.llama.fi
DEFILLAMA_TIMEOUT=30
DEFILLAMA_RETRY=3

# GitHub（P0，免费，无 token 时速率限制 60 req/h；建议申请 token 到 5000 req/h）
# 获取地址：https://github.com/settings/tokens
GITHUB_ENABLED=true
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT=30
GITHUB_RETRY=3

# CoinGecko（P0，免费额度约 10-30 calls/min；付费 Demo plan 提升额度）
# 获取地址：https://www.coingecko.com/en/developers/dashboard
COINGECKO_ENABLED=true
COINGECKO_API_KEY=
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_TIMEOUT=30
COINGECKO_RETRY=3

# CryptoRank（可选）
CRYPTORANK_ENABLED=false
CRYPTORANK_API_KEY=
CRYPTORANK_BASE_URL=https://api.cryptorank.io/v1

# Twitter/X（P0，付费，需 Basic Tier $100/月）
# 获取地址：https://developer.x.com/en/portal/dashboard
TWITTER_ENABLED=false
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_TIMEOUT=30
TWITTER_RETRY=3
TWITTER_KOL_ACCOUNTS=a16z,paradigm,VitalikButerin,cz_binance,BinanceLabs,coinbase,panteracapital,dragonfly_xyz,polychaincap,1kxnetwork
TWITTER_KEYWORDS=#airdrop,#testnet,#points,#mainnet,points program,no token yet,TGE soon

# 链上数据（P1，Etherscan 免费 API key；Alchemy webhook 可选）
# Etherscan API key 获取地址：https://etherscan.io/apis
# Alchemy API key 获取地址：https://dashboard.alchemy.com/
ETHERSCAN_ENABLED=false
ETHERSCAN_API_KEY=
ETHERSCAN_TIMEOUT=30
ETHERSCAN_RETRY=3
ALCHEMY_API_KEY=
ALCHEMY_WEBHOOK_URL=

# Galxe / Layer3（P1，任务平台，需 GraphQL/REST API key）
# Galxe 开发者：https://developer.galxe.com/
# Layer3 API 文档：https://docs.layer3.io/
GALXE_ENABLED=false
GALXE_API_KEY=
GALXE_TIMEOUT=30
GALXE_RETRY=3
LAYER3_ENABLED=false
LAYER3_API_KEY=
LAYER3_TIMEOUT=30
LAYER3_RETRY=3

# Dune Analytics (可选，需 API key)
# 获取地址：https://dune.com/settings/api
DUNE_ENABLED=false
DUNE_API_KEY=

# ── Feature Flags ─────────────────────────────
ENABLE_LLM_ENHANCEMENT=false
ENABLE_FEEDBACK_SYSTEM=true
ENABLE_EVENTS_TRACKING=false
ENABLE_USER_SYSTEM=false
ENABLE_COMPETITION_CACHE=true
# Automatic Opportunity v2.0 Shadow evaluation is non-authoritative.
OPPORTUNITY_SHADOW_ENABLED=false
# Deterministic fraction of persisted, scored projects selected by project ID.
OPPORTUNITY_SHADOW_SAMPLE_RATE=0.0

# ── 缓存配置 ──────────────────────────────────
COMPETITION_CACHE_TTL=3600
COMPETITION_CACHE_MAX_SIZE=1000

# ── 数据质量 ──────────────────────────────────
# 缺失字段降级阈值
MISSING_FIELDS_THRESHOLD=3
CONFIDENCE_THRESHOLD=0.5

# ── 安全配置 ──────────────────────────────────
# CORS
CORS_ORIGINS=http://localhost:3002,http://localhost:8002
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── 监控 ──────────────────────────────────────
# Prometheus metrics endpoint
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Health check
HEALTH_CHECK_PATH=/health

# ── OpenTelemetry（可选，P2）────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=airdrop-alpha
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ── 部署 ──────────────────────────────────────
# Docker
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE=web3-airdrop-alpha/web3-airdrop-alpha-agent

# Docker Compose 生产栈（PostgreSQL）
POSTGRES_PASSWORD=change-me-in-production
# GRAFANA_PASSWORD=change-me-in-production

# ── 开发/调试 ─────────────────────────────────
# 种子数据
SEED_ON_STARTUP=false
SEED_DATA_PATH=scripts/seed.py

# 测试模式（仅 CI 使用）
TESTING=false
TEST_DB_PATH=:memory:

# RootData (funding / project DB) — apply key at https://www.rootdata.com/api
ROOTDATA_ENABLED=false
ROOTDATA_API_KEY=
ROOTDATA_BASE_URL=https://api.rootdata.com
ROOTDATA_TIMEOUT=30
ROOTDATA_CRON=45 9 * * *
