# ──────────────────────────────────────
# Web3 Airdrop Alpha Agent - 环境变量模板
# 复制为 .env 并填写真实值
# ──────────────────────────────────────

# ── 应用配置 ──────────────────────────
# 运行环境：development / production / testing
APP_ENV=development
# 应用名称
APP_NAME=airdrop-alpha
# 应用版本号
APP_VERSION=0.1.0
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志格式：console / json
LOG_FORMAT=console
# 可选：日志文件路径（启用后同时输出到文件）
LOG_FILE=
# 调试模式（生产环境必须关闭）
DEBUG=false

# 服务监听地址和端口
HOST=0.0.0.0
PORT=8002
# 健康检查路径
HEALTH_CHECK_PATH=/health
# 可信代理数量（限流取真实 IP 用）
TRUSTED_PROXY_COUNT=0

# ── 鉴权与安全 ────────────────────────
# API 密钥（留空=不开启鉴权；生产环境必须 ≥ 32 字符）
API_KEY=
# JWT 签名密钥（匿名 token 用；生产环境必须设置）
AUTH_TOKEN_SECRET=
# JWT 有效期（小时）
AUTH_TOKEN_TTL_HOURS=24

# ── CORS 与限流 ───────────────────────
# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:3002,http://localhost:8002
# 是否允许携带凭证
CORS_CREDENTIALS=true
# 限流开关
RATE_LIMIT_ENABLED=true
# 每窗口最大请求数
RATE_LIMIT_REQUESTS=100
# 限流窗口（秒）
RATE_LIMIT_WINDOW=60

# ── 数据库 ──────────────────────────────
# DB_BACKEND=sqlite / postgres
DB_BACKEND=sqlite
# SQLite 路径（仅 sqlite 模式）
DB_PATH=data/airdrop.db
# SQLite busy timeout（毫秒）
SQLITE_BUSY_TIMEOUT_SECONDS=5
# PostgreSQL 连接（仅 postgres 模式）
DATABASE_URL=postgresql://airdrop:airdrop@localhost:5432/airdrop
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airdrop
POSTGRES_USER=airdrop
POSTGRES_PASSWORD=airdrop

# ── 评分权重（Σ = 1.0，启动断言）──────
WEIGHT_VERSION=score-v1.4
WEIGHT_AIRDROP_SIGNAL=0.18
WEIGHT_NARRATIVE_TIMING=0.15
WEIGHT_EXECUTION=0.13
WEIGHT_TEAM_REPUTATION=0.12
WEIGHT_RISK=0.12
WEIGHT_TOKENOMICS=0.10
WEIGHT_COMPETITION=0.10
WEIGHT_TRANSPARENCY=0.10

# ── 质量阈值 ──────────────────────────
# discovery_score ≥ 此值才进入分析管道
DISCOVERY_SCORE_ANALYSIS_THRESHOLD=0.3
# 低于此值的评分标记为低置信
CONFIDENCE_THRESHOLD=0.5
# 缺失字段数超过此值触发降级
MISSING_FIELDS_THRESHOLD=3

# ── 功能开关 ──────────────────────────
# LLM 增强（需配置 API Key 后才生效）
ENABLE_LLM_ENHANCEMENT=false
# 反馈系统（样本采集）
ENABLE_FEEDBACK_SYSTEM=true
# 事件追踪（埋点）
ENABLE_EVENTS_TRACKING=false
# 用户系统（多用户与权限）
ENABLE_USER_SYSTEM=false
# 竞争格局缓存
ENABLE_COMPETITION_CACHE=true
# Seed fallback（外部源全失败时回退内置数据）
SEED_FALLBACK_ENABLED=true
SEED_ON_STARTUP=false
SEED_DATA_PATH=data/seed_projects.json

# ── Opportunity 旁路引擎 ──────────────
OPPORTUNITY_SHADOW_ENABLED=true
OPPORTUNITY_SHADOW_SAMPLE_RATE=1.0
OPPORTUNITY_ECONOMIC_SNAPSHOT_ENABLED=true
OPPORTUNITY_ECONOMIC_EVIDENCE_EMIT_ENABLED=true
OPPORTUNITY_ECONOMIC_RESOLVER_ENABLED=true
OPPORTUNITY_ECONOMIC_SOURCE_COINGECKO_ENABLED=true
OPPORTUNITY_ECONOMIC_SOURCE_CRYPTORANK_ENABLED=true
OPPORTUNITY_ECONOMIC_SOURCE_DEFILLAMA_ENABLED=true

# ── Heat Signal ───────────────────────
HEAT_SIGNAL_ENABLED=true
HEAT_SIGNAL_LOOKBACK_HOURS=24
HEAT_SIGNAL_MAX_MULTIPLIER=2.0
HEAT_SIGNAL_MIN_MULTIPLIER=0.5
HEAT_SIGNAL_TTL_SECONDS=3600

# ── 采集器 API Key ─────────────────────
ETHERSCAN_API_KEY=
CRYPTORANK_API_KEY=
COINGECKO_API_KEY=
# 需要 Twitter API Bearer Token 才能启用 KOL/Keywords 推文采集
TWITTER_BEARER_TOKEN=
# 以下四个采集器处于就绪状态，配 key 即可启用
ROOTDATA_API_KEY=
GALXE_API_KEY=
LAYER3_API_KEY=
ALCHEMY_API_KEY=
DUNE_API_KEY=

# ── 采集器通用配置 ────────────────────
# DefiLlama
DEFILLAMA_ENABLED=true
DEFILLAMA_BASE_URL=https://api.llama.fi
DEFILLAMA_TIMEOUT=30
DEFILLAMA_RETRY=2
DEFILLAMA_CRON=0 8 * * *

# GitHub
GITHUB_ENABLED=true
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_TIMEOUT=30
GITHUB_RETRY=2
GITHUB_CRON=30 8 * * *

# CoinGecko
COINGECKO_ENABLED=true
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_TIMEOUT=30
COINGECKO_RETRY=2
COINGECKO_CRON=0 9 * * *

# Twitter / X
TWITTER_ENABLED=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_TIMEOUT=30
TWITTER_RETRY=2
TWITTER_KEYWORD_CRON=*/15 * * * *
TWITTER_KOL_CRON=0 9 * * *
TWITTER_KEYWORDS=#airdrop,#testnet,#points
TWITTER_KOL_ACCOUNTS=a16z,paradigm,VitalikButerin

# Etherscan
ETHERSCAN_ENABLED=false
ETHERSCAN_TIMEOUT=30
ETHERSCAN_RETRY=2
ETHERSCAN_CRON=0 10 * * *

# RootData
ROOTDATA_ENABLED=false
ROOTDATA_BASE_URL=https://api.rootdata.com
ROOTDATA_TIMEOUT=30
ROOTDATA_RETRY=2
ROOTDATA_CRON=0 11 * * *

# CryptoRank
CRYPTORANK_ENABLED=false
CRYPTORANK_BASE_URL=https://api.cryptorank.io/v1
CRYPTORANK_TIMEOUT=30
CRYPTORANK_RETRY=2
CRYPTORANK_CRON=0 11 * * *

# Galxe
GALXE_ENABLED=false
GALXE_TIMEOUT=30
GALXE_RETRY=2
GALXE_CRON=0 12 * * *

# Layer3
LAYER3_ENABLED=false
LAYER3_TIMEOUT=30
LAYER3_RETRY=2
LAYER3_CRON=0 12 * * *

# ── Fetcher 配置 ──────────────────────
FETCHER_CACHE_DIR=data/fetcher_cache
FETCHER_CACHE_TTL_SECONDS=300
FETCHER_CIRCUIT_BREAKER_THRESHOLD=5
FETCHER_CIRCUIT_BREAKER_TIMEOUT_SECONDS=60
FETCHER_SEMAPHORE_SIZE=10

# ── LLM 增强 ──────────────────────────
# 逗号分隔的多个接口 URL（启用故障转移，按顺序尝试）
# 单个接口用 OPENAI_API_KEY + OPENAI_BASE_URL
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 多接口：LLM_BASEURL_1, LLM_API_KEY_1, LLM_MODELS_1_1, ...
# LLM_BASEURL_1=
# LLM_API_KEY_1=
# LLM_MODELS_1_1=gpt-4o-mini
LLM_API_KEYS=
LLM_BASE_URLS=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LLM_DAILY_BUDGET_USD=1.0
LLM_DISCOVERY_SCORE_THRESHOLD=0.7
LLM_SEMAPHORE_SIZE=3

# ── 调度器 ────────────────────────────
SCHEDULER_ENABLED=true
COLLECTION_SCHEDULER_ENABLED=true
COLLECTION_AUTO_RUN_ENABLED=false
CRON_EXPRESSION=0 8 * * *
SCHEDULER_MISFIRE_GRACE_SECONDS=300
ANALYSIS_RUN_LIMIT=100
MAX_CONCURRENT_PROJECTS=5
TIMEZONE=UTC

# ── 数据保留策略 ──────────────────────
RAW_PROJECTS_RETENTION_DAYS=30
PROJECT_SIGNALS_RETENTION_DAYS=90
COLLECTION_LOGS_RETENTION_DAYS=90

# ── 监控（Prometheus / Grafana）───────
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ── 链路追踪（OpenTelemetry / Jaeger）──
# 设为 true 启用 OTel SDK + 自动埋点
OTEL_ENABLED=false
# OTLP 导出端点（gRPC）
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# 服务名称
OTEL_SERVICE_NAME=airdrop-alpha
# 采样策略：traceidratio / always_on / always_off
OTEL_TRACES_SAMPLER=traceidratio
# 采样率（生产环境建议 0.1）
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_SAMPLE_RATE=1.0

# ── 告警通知（Alertmanager → Telegram）──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Alchemy Webhook ───────────────────
ALCHEMY_WEBHOOK_URL=

# ── 竞争格局缓存 ──────────────────────
COMPETITION_CACHE_TTL=3600
COMPETITION_CACHE_MAX_SIZE=1000
