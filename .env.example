# ──────────────────────────────────────
# Web3 Airdrop Alpha Agent - 环境变量模板
# 复制为 .env 并填写真实值
#
# 这份文件由门禁 backend/tests/test_env_example_parity.py 逐行比对代码真相：
#   1. 每个键必须是 app/config.py 的 Settings 字段，或带 `env-external` 标记
#      说明谁真正读它（不经 Settings 的 SDK / compose 变量）；
#   2. 每个值必须等于代码默认值，或带 `env-differs` 标记写出为什么故意不同。
# 标记写在键的上一行注释里，逐键显式、可 grep 审计 —— 不做整文件豁免。
# 改了 app/config.py 的默认值而没改这里，测试会当场变红。
# ──────────────────────────────────────

# ── 应用配置 ──────────────────────────
# 运行环境：development / production / testing
APP_ENV=development
# 应用名称
APP_NAME=web3-airdrop-alpha-agent
# 应用版本号
APP_VERSION=0.1.0
# 日志级别：DEBUG / INFO / WARNING / ERROR
# 注：填了无法识别的值会退回 INFO（不是 DEBUG）—— 配置写错不该反而放开输出
LOG_LEVEL=INFO
# 日志格式：console / json
# env-differs: 代码默认 json（生产用，便于日志采集）；本地开发用 console 人眼可读
LOG_FORMAT=console
# 可选：日志文件路径（启用后同时输出到文件）
# ⚠️ 当前没有任何日志轮转：没有 RotatingFileHandler、compose 没配 max-size、
# 也没有 logrotate。开启文件日志后请自行配置轮转，否则会无上限增长。
LOG_FILE=
# 调试模式（生产环境必须关闭）
DEBUG=false

# 服务监听地址和端口
HOST=0.0.0.0
PORT=8002
# 健康检查路径
HEALTH_CHECK_PATH=/health
# 可信代理数量（限流取真实 IP 用）
TRUSTED_PROXY_COUNT=0

# ── 鉴权与安全 ────────────────────────
# API 密钥（留空=**整个鉴权中间件短路**，所有接口都不校验；生产环境必须 ≥ 32 字符）
API_KEY=
# JWT 签名密钥（匿名 token 用）。生产环境必填，为空则拒绝启动（容器会 CrashLoop）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=
# JWT 有效期（小时）
AUTH_TOKEN_TTL_HOURS=72

# ── CORS 与限流 ───────────────────────
# CORS 允许的来源（逗号分隔）。下面是本地开发值；
# 生产环境必须改成真实前端域名 —— 含 localhost/127.0.0.1 时会拒绝启动
CORS_ORIGINS=http://localhost:3002,http://localhost:8002
# 是否允许携带凭证
CORS_CREDENTIALS=true
# ⚠️ 下面三个限流参数**当前没有任何代码读取**（见 app/rate_limit.py 顶部说明）：
# SECURITY.md 要求的「每 IP 60 req/min」尚未实现。改这里不会有任何效果。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── 数据库 ──────────────────────────────
# DB_BACKEND=sqlite / postgres
DB_BACKEND=sqlite
# SQLite 路径（仅 sqlite 模式）。相对路径按**进程工作目录**解析，不是仓库根目录。
DB_PATH=data/airdrop.db
# SQLite busy timeout（**秒**，不是毫秒）
SQLITE_BUSY_TIMEOUT_SECONDS=10.0
#
# PostgreSQL：两条激活路径，任选其一
#   A. 设 DB_BACKEND=postgres → 自动用下面的 POSTGRES_* 分项组装连接串
#   B. 直接设 DATABASE_URL=postgresql://… → 优先级最高，且会**反向把
#      DB_BACKEND 改成 postgres**
#
# ⚠️ 所以 DATABASE_URL 在这里刻意保持注释状态。此前这行是打开的，于是
# 「DB_BACKEND=sqlite」这句被静默推翻 —— 照模板复制出来的 .env 实际连的是
# Postgres，而不是它自己声明的 SQLite。要用 PG 时才取消注释。
# DATABASE_URL=postgresql://airdrop:airdrop@localhost:5432/airdrop
#
# env-differs: 代码默认值是 CI 的测试实例（127.0.0.1:5433/airdrop_test）。
# 模板不该把人指向测试库，所以这里给的是常规本地 PG 的地址。
POSTGRES_HOST=localhost
# env-differs: 同上，代码默认 5433 是测试实例端口
POSTGRES_PORT=5432
# env-differs: 同上，代码默认 airdrop_test 是测试库名
POSTGRES_DB=airdrop
POSTGRES_USER=airdrop
# env-differs: 同上，代码默认 airdrop_test 是测试库口令
POSTGRES_PASSWORD=airdrop

# ── 评分权重（Σ = 1.0，启动断言）──────
# 权重版本号，随每条评分写入 projects.weight_version（ADR-006）。
# 注意别和评分模型名 `score-v1.4` 混为一谈：那是模型代号（前端展示、
# Opportunity 旁路引擎的 LEGACY_MODEL_VERSION），这里是**权重版本**，
# 两个是不同的版本轴。此前这里误填成 score-v1.4，会把模型名写进权重列。
WEIGHT_VERSION=v1.2
WEIGHT_AIRDROP_SIGNAL=0.18
WEIGHT_NARRATIVE_TIMING=0.15
WEIGHT_EXECUTION=0.13
WEIGHT_TEAM_REPUTATION=0.12
WEIGHT_RISK=0.12
WEIGHT_TOKENOMICS=0.10
WEIGHT_COMPETITION=0.10
WEIGHT_TRANSPARENCY=0.10

# ── 质量阈值 ──────────────────────────
# discovery_score ≥ 此值才进入分析管道（实测低于此值的采集记录占 73%）
DISCOVERY_SCORE_ANALYSIS_THRESHOLD=0.3
# 低于此值的评分标记为低置信
CONFIDENCE_THRESHOLD=0.5
# 缺失字段数超过此值触发降级
MISSING_FIELDS_THRESHOLD=3

# ── 功能开关 ──────────────────────────
# LLM 增强（需配置 API Key 后才生效）
ENABLE_LLM_ENHANCEMENT=false
# 反馈系统（样本采集）
ENABLE_FEEDBACK_SYSTEM=true
# 事件追踪（埋点）
ENABLE_EVENTS_TRACKING=false
# 用户系统（多用户与权限）
ENABLE_USER_SYSTEM=false
# 竞争格局缓存
ENABLE_COMPETITION_CACHE=true
# Seed fallback（外部源全失败时回退内置数据）
# 开启时：采集队列为空会用 app/seed.py 的 8 个内置项目评分入库（source='seed'、
# fetched_at=NULL，前端显示「种子数据」）。方便演示，但 Dashboard 汇总会把它们
# 算进去。**生产环境建议设为 false**，让「采集全挂」如实表现为 0 条。
SEED_FALLBACK_ENABLED=true
# 启动时灌入种子数据。**生产环境建议设为 false**，否则空库一启动就有 8 个
# 假项目，看起来像已经采集过了。
SEED_ON_STARTUP=true
# 种子数据来源。默认指向脚本 scripts/seed.py（该文件存在）。
# 此前这里写的是 data/seed_projects.json —— 那个文件在仓库里**不存在**。
SEED_DATA_PATH=scripts/seed.py

# ── Opportunity 旁路引擎 ──────────────
# 非权威影子评估（ADR-014）。不会改写 projects.score / label / recommendation。
OPPORTUNITY_SHADOW_ENABLED=true
OPPORTUNITY_SHADOW_SAMPLE_RATE=1.0
# 下面 6 个经济性开关有**级联校验**，顺序不能乱开，否则启动直接报错：
#   evidence_emit=true 要求 snapshot=true；resolver=true 要求 evidence_emit=true。
# 代码默认全 false，模板保持一致 —— 打开它们要先明白上面这条链。
OPPORTUNITY_ECONOMIC_SNAPSHOT_ENABLED=false
OPPORTUNITY_ECONOMIC_EVIDENCE_EMIT_ENABLED=false
OPPORTUNITY_ECONOMIC_RESOLVER_ENABLED=false
OPPORTUNITY_ECONOMIC_SOURCE_COINGECKO_ENABLED=false
OPPORTUNITY_ECONOMIC_SOURCE_CRYPTORANK_ENABLED=false
OPPORTUNITY_ECONOMIC_SOURCE_DEFILLAMA_ENABLED=false

# ── Heat Signal ───────────────────────
HEAT_SIGNAL_ENABLED=true
HEAT_SIGNAL_LOOKBACK_HOURS=72
HEAT_SIGNAL_MAX_MULTIPLIER=1.3
HEAT_SIGNAL_MIN_MULTIPLIER=0.7
HEAT_SIGNAL_TTL_SECONDS=300

# ── 采集器 API Key ─────────────────────
#
# ⚠️ **只配 Key 不会启用任何采集源。** 一个源真正会跑，需要同时满足三条：
#   ① 对应的 *_ENABLED=true（见下一节，10 个源里只有 3 个默认为 true）
#   ② 该源需要的 Key 已配（下面标注了哪些需要）
#   ③ 数据库 data_sources 表里该源的 enabled=1（运维开关，可在 /ops 页面切）
# 三者缺一就不跑，但它在 GET /api/v1/collections/sources 里**依然会被列出**，
# 只是 config_ready=false。排查「为什么没发现新项目」时先看这一列，
# 否则会去翻一个从未运行过的源的日志，什么都找不到，误判成分析侧的问题。
#
# 不需要 Key 的源：defillama、coingecko（coingecko 的 Key 只用于提额度）
ETHERSCAN_API_KEY=
CRYPTORANK_API_KEY=
COINGECKO_API_KEY=
# 两个 twitter 采集器（KOL 轮询 + 关键词搜索）都只认这一个 Bearer Token。
# 下面的 TWITTER_API_KEY / TWITTER_API_SECRET **采集器根本不读**，
# 填了它们 twitter 依然不会跑。
TWITTER_BEARER_TOKEN=
ROOTDATA_API_KEY=
GALXE_API_KEY=
LAYER3_API_KEY=
# Alchemy Webhook 用（POST /api/v1/webhook/alchemy 校验来源）
ALCHEMY_API_KEY=
# ⚠️ DUNE_API_KEY 目前**没有任何代码读取它**，配了也不会生效。
# 保留是因为它在配置里已声明；真要接 Dune 需要先写 collector。
DUNE_API_KEY=

# ── 采集器通用配置 ────────────────────
# cron 全部按 **UTC** 解释；misfire_grace_time=3600s、coalesce=true、max_instances=1。
# 下面 10 组的 cron 与 app/config.py 的默认值由门禁逐条比对。
#
# DefiLlama（不需要 Key，默认开）
DEFILLAMA_ENABLED=true
DEFILLAMA_BASE_URL=https://api.llama.fi
DEFILLAMA_TIMEOUT=30
DEFILLAMA_RETRY=3
DEFILLAMA_CRON=0 8 * * *

# GitHub（需要 GITHUB_TOKEN，默认开）
GITHUB_ENABLED=true
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_TIMEOUT=30
GITHUB_RETRY=3
GITHUB_CRON=30 8 * * *

# CoinGecko（不需要 Key，默认开）
COINGECKO_ENABLED=true
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_TIMEOUT=30
COINGECKO_RETRY=3
COINGECKO_CRON=0 9 * * *

# Twitter / X（需要 TWITTER_BEARER_TOKEN，默认关）
# ⚠️ 这**一个**开关同时控制 KOL 轮询和关键词搜索两个采集器，没法只留一个。
TWITTER_ENABLED=false
# ⚠️ 下面两个采集器不读（真正用的是 TWITTER_BEARER_TOKEN），保留仅为兼容配置声明
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_TIMEOUT=30
TWITTER_RETRY=3
TWITTER_KEYWORD_CRON=*/15 * * * *
TWITTER_KOL_CRON=0 * * * *
TWITTER_KEYWORDS=#airdrop,#testnet,#points,#mainnet,points program,no token yet,TGE soon
TWITTER_KOL_ACCOUNTS=a16z,paradigm,VitalikButerin,cz_binance,BinanceLabs,coinbase,panteracapital,dragonfly_xyz,polychaincap,1kxnetwork

# Etherscan（需要 ETHERSCAN_API_KEY，默认关）
ETHERSCAN_ENABLED=false
ETHERSCAN_TIMEOUT=30
ETHERSCAN_RETRY=3
ETHERSCAN_CRON=0 */6 * * *

# RootData（需要 ROOTDATA_API_KEY，默认关）
ROOTDATA_ENABLED=false
ROOTDATA_BASE_URL=https://api.rootdata.com
ROOTDATA_TIMEOUT=30
ROOTDATA_RETRY=3
ROOTDATA_CRON=45 9 * * *

# CryptoRank（需要 CRYPTORANK_API_KEY，默认关）
CRYPTORANK_ENABLED=false
CRYPTORANK_BASE_URL=https://api.cryptorank.io/v1
CRYPTORANK_TIMEOUT=30
CRYPTORANK_RETRY=3
CRYPTORANK_CRON=15 9 * * *

# Galxe（需要 GALXE_API_KEY，默认关）
GALXE_ENABLED=false
GALXE_TIMEOUT=30
GALXE_RETRY=3
GALXE_CRON=0 10 * * *

# Layer3（需要 LAYER3_API_KEY，默认关）
LAYER3_ENABLED=false
LAYER3_TIMEOUT=30
LAYER3_RETRY=3
LAYER3_CRON=30 10 * * *

# ── Fetcher 配置 ──────────────────────
# 缓存目录。默认 cache/（该目录存在）；此前这里写 data/fetcher_cache —— 不存在。
FETCHER_CACHE_DIR=cache
FETCHER_CACHE_TTL_SECONDS=3600
FETCHER_CIRCUIT_BREAKER_THRESHOLD=5
FETCHER_CIRCUIT_BREAKER_TIMEOUT_SECONDS=60
FETCHER_SEMAPHORE_SIZE=10

# ── LLM 增强 ──────────────────────────
# 单接口：OPENAI_API_KEY + OPENAI_BASE_URL
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 多接口故障转移：按序号成组设置**编号变量**（由 config.py 直接读 os.environ，
# 不是 Settings 字段，所以不出现在本文件的键列表里）：
#   LLM_BASEURL_1=https://api.openai.com/v1
#   LLM_API_KEY_1=sk-xxx
#   LLM_MODELS_1_1=gpt-4o-mini
#   LLM_MODELS_1_2=gpt-4o
#   LLM_BASEURL_2=... / LLM_API_KEY_2=... / LLM_MODELS_2_1=...
# 此前这里还列了 LLM_API_KEYS= / LLM_BASE_URLS= 两个逗号分隔变量，
# 全仓**没有任何代码读它们** —— 已删除，别再照着填。
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
# ⚠️ 这个预算值目前只被两个只读接口读出来展示，**没有任何按它拦截调用的逻辑**，
# 也没有 token / 成本指标。真实存在的成本闸门只有 /api/v1/run 的频率限制
# （LLM 开启 1 次/小时，关闭 10 次/小时）。别指望它能自动停用 LLM。
LLM_DAILY_BUDGET_USD=1.0
# 仅 discovery_score ≥ 此值的项目启用 LLM（ADR-012 分级）
LLM_DISCOVERY_SCORE_THRESHOLD=0.7
LLM_SEMAPHORE_SIZE=5

# ── 调度器 ────────────────────────────
SCHEDULER_ENABLED=true
COLLECTION_SCHEDULER_ENABLED=true
# 采集完成后**不会**自动接着跑分析：两条链解耦，各按自己的 cron 走
COLLECTION_AUTO_RUN_ENABLED=false
# 分析任务 cron（UTC）
CRON_EXPRESSION=0 8 * * *
SCHEDULER_MISFIRE_GRACE_SECONDS=3600
ANALYSIS_RUN_LIMIT=100
MAX_CONCURRENT_PROJECTS=10
TIMEZONE=UTC

# ── 数据保留策略 ──────────────────────
# 主表 → 归档表
RAW_PROJECTS_RETENTION_DAYS=30
PROJECT_SIGNALS_RETENTION_DAYS=90
COLLECTION_LOGS_RETENTION_DAYS=90
# 未过分析阈值（discovery_score < DISCOVERY_SCORE_ANALYSIS_THRESHOLD）的采集记录。
# 它们永远不会被标记 processed=1，所以不满足上面那档条件；实测占 raw_projects 的
# 73%，没有这一档就会无限累积（1 年约 16.8 万行 / 76 MB）。
UNPROCESSED_RAW_RETENTION_DAYS=90
# 归档表自身的保留期（超期直接删除，无下一级归档）
RAW_ARCHIVE_RETENTION_DAYS=180
SIGNALS_ARCHIVE_RETENTION_DAYS=365
# 归档调度。默认 03:00，在采集 job（08:00–10:30）之前跑完，避免和写入争锁。
# ⚠️ 归档逻辑至今**没有观测到一次真实执行**（archive_runs 表 0 行）——
# 本地数据还没有记录超过保留期，每次触发都「无事可做」。生产上等于未验证路径。
ARCHIVE_SCHEDULER_ENABLED=true
ARCHIVE_CRON=0 3 * * *

# ── 监控（Prometheus / Grafana）───────
METRICS_ENABLED=true
# ⚠️ /metrics 当前无条件暴露，nginx 也没有 allow/deny 限制。生产环境请在
# 反向代理层限制来源，或放到内网端口。
METRICS_PATH=/metrics

# ── 链路追踪（OpenTelemetry / Jaeger）──
# 设为 true 启用 OTel SDK + 自动埋点
OTEL_ENABLED=false
# env-external: OTel SDK 直接读此环境变量，不经 Settings（config.py 只在日志里回显）
# OTLP 导出端点（gRPC）
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# 服务名称
OTEL_SERVICE_NAME=airdrop-alpha
# env-external: OTel SDK 直接读此环境变量，不经 Settings
# 采样策略：traceidratio / always_on / always_off
OTEL_TRACES_SAMPLER=traceidratio
# env-external: OTel SDK 直接读此环境变量，不经 Settings
# 采样率（生产环境建议 0.1）
OTEL_TRACES_SAMPLER_ARG=1.0
# 仅用于日志回显，实际采样由上面两个 SDK 变量决定
OTEL_SAMPLE_RATE=1.0

# ── 告警通知（Alertmanager → Telegram）──
# env-external: 由 docker-compose.prod.yml 注入 alertmanager.yml 模板，不经 Settings
TELEGRAM_BOT_TOKEN=
# env-external: 同上，由 compose 注入 alertmanager.yml，不经 Settings
TELEGRAM_CHAT_ID=

# ── Alchemy Webhook ───────────────────
ALCHEMY_WEBHOOK_URL=

# ── 竞争格局缓存 ──────────────────────
COMPETITION_CACHE_TTL=3600
COMPETITION_CACHE_MAX_SIZE=1000
