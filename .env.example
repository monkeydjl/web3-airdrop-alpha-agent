# ──────────────────────────────────────────────
# Environment Configuration Template
# ──────────────────────────────────────────────
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 填入实际值
#   3. .env 已加入 .gitignore，不会提交到仓库
#
# 优先级：环境变量 > .env 文件 > 代码默认值
# ──────────────────────────────────────────────

# ── 应用基础 ──────────────────────────────────
APP_NAME=web3-airdrop-alpha-agent
APP_ENV=production
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=json

# ── Docker 部署端口 ───────────────────────────
# API 服务端口（映射到主机）
API_PORT=8000

# Nginx 端口（如果启用）
NGINX_PORT=80

# 时区
TZ=Asia/Shanghai

# ── 数据库 ────────────────────────────────────
# MVP: SQLite (默认)
# V2+: PostgreSQL (设置 DATABASE_URL 后自动切换)
DB_PATH=/app/data/app.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/airdrop

# ── API 鉴权 ──────────────────────────────────
# MVP: 空 = 无鉴权
# V2+: Bearer token
API_KEY=
# API_KEY_HEADER=X-API-Key

# ── LLM 配置 (ADR-001) ───────────────────────
# 默认关闭 LLM，仅规则引擎运行
# 设置 OPENAI_API_KEY 后自动启用 LLM 增强
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LLM_DAILY_BUDGET_USD=1.0
LLM_SEMAPHORE_SIZE=5

# ── 评分权重 (Σ=1.0，启动时断言) ─────────────
WEIGHT_AIRDROP_SIGNAL=0.20
WEIGHT_NARRATIVE_TIMING=0.20
WEIGHT_TEAM_REPUTATION=0.15
WEIGHT_RISK=0.15
WEIGHT_TOKENOMICS=0.15
WEIGHT_COMPETITION=0.15

# ── 并发控制 (ADR-007) ───────────────────────
MAX_CONCURRENT_PROJECTS=10
# LLM_SEMAPHORE_SIZE 已在 LLM 配置中定义

# ── 调度配置 (ADR-005) ───────────────────────
SCHEDULER_ENABLED=true
CRON_EXPRESSION=0 8 * * *
TIMEZONE=UTC

# ── 外部数据源 ────────────────────────────────
# DefiLlama
DEFILLAMA_ENABLED=true
DEFILLAMA_BASE_URL=https://api.llama.fi
DEFILLAMA_TIMEOUT=30
DEFILLAMA_RETRY=3

# CryptoRank (可选)
CRYPTORANK_ENABLED=false
CRYPTORANK_API_KEY=
CRYPTORANK_BASE_URL=https://api.cryptorank.io/v1

# Twitter/X (可选)
TWITTER_ENABLED=false
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# Dune Analytics (可选)
DUNE_ENABLED=false
DUNE_API_KEY=

# ── Feature Flags ─────────────────────────────
ENABLE_LLM_ENHANCEMENT=false
ENABLE_FEEDBACK_SYSTEM=false
ENABLE_EVENTS_TRACKING=false
ENABLE_USER_SYSTEM=false
ENABLE_COMPETITION_CACHE=true

# ── 缓存配置 ──────────────────────────────────
COMPETITION_CACHE_TTL=3600
COMPETITION_CACHE_MAX_SIZE=1000

# ── 数据质量 ──────────────────────────────────
# 缺失字段降级阈值
MISSING_FIELDS_THRESHOLD=3
CONFIDENCE_THRESHOLD=0.5

# ── 安全配置 ──────────────────────────────────
# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── 监控 ──────────────────────────────────────
# Prometheus metrics endpoint
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Health check
HEALTH_CHECK_PATH=/health

# ── OpenTelemetry（可选，P2）────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=airdrop-alpha
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ── 部署 ──────────────────────────────────────
# Docker
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE=web3-airdrop-alpha/web3-airdrop-alpha-agent

# Docker Compose 生产栈（PostgreSQL）
POSTGRES_PASSWORD=change-me-in-production
# GRAFANA_PASSWORD=change-me-in-production

# ── 开发/调试 ─────────────────────────────────
# 种子数据
SEED_ON_STARTUP=false
SEED_DATA_PATH=scripts/seed.py

# 测试模式（仅 CI 使用）
TESTING=false
TEST_DB_PATH=:memory:

