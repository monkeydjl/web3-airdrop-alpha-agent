# ──────────────────────────────────────
# Web3 Airdrop Alpha Agent - 环境变量模板
# 复制为 .env 并填写真实值
# ──────────────────────────────────────

# ── 应用配置 ──────────────────────────
# 运行环境：development / production / testing
APP_ENV=development
# 应用版本号
APP_VERSION=0.1.0
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志格式：console / json
LOG_FORMAT=console
# 可选：日志文件路径（启用后同时输出到文件）
LOG_FILE=

# API 密钥（留空=不开启鉴权）
API_KEY=

# API 端口（默认 8002）
API_PORT=8002

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=

# ── 数据库 ──────────────────────────────
# DB_BACKEND=sqlite / postgres
DB_BACKEND=sqlite
# SQLite 路径（仅 sqlite 模式）
DB_PATH=data/airdrop.db
# PostgreSQL 连接串（仅 postgres 模式）
DATABASE_URL=postgresql://airdrop:airdrop@localhost:5432/airdrop

# ── 采集器 API Key ─────────────────────
ETHERSCAN_API_KEY=
CRYPTORANK_API_KEY=
COINGECKO_API_KEY=
# 需要 Twitter API Bearer Token 才能启用 KOL/Keywords 推文采集
TWITTER_BEARER_TOKEN=
# 以下四个采集器处于就绪状态，配 key 即可启用
ROOTDATA_API_KEY=
GALXE_API_KEY=
LAYER3_API_KEY=
ALCHEMY_API_KEY=
DUNE_API_KEY=

# ── LLM ──────────────────────────────────
# 逗号分隔的多个接口 URL（启用故障转移，按顺序尝试）
# 单个接口用 OPENAI_API_KEY + OPENAI_BASE_URL
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_API_KEYS=
LLM_BASE_URLS=

# ── 监控（Grafana / Prometheus）───
GRAFANA_PASSWORD=

# ── 链路追踪（OpenTelemetry / Jaeger）──
# 设为 true 启用 OTel SDK + 自动埋点
OTEL_ENABLED=false
# OTLP 导出端点（gRPC）
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# 服务名称
OTEL_SERVICE_NAME=airdrop-alpha
# 采样策略：traceidratio / always_on / always_off
OTEL_TRACES_SAMPLER=traceidratio
# 采样率（生产环境建议 0.1）
OTEL_TRACES_SAMPLER_ARG=1.0

# ── 告警通知（Alertmanager → Telegram）──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=