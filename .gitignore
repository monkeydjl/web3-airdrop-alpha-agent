# ──────────────────────────────────────────────
# Git Ignore Patterns
# ──────────────────────────────────────────────
# 遵循 gitignore.io 标准模板 + 项目特定规则
# 生成标签：Python,Docker,Node,Linux,Windows,macOS,JetBrains,VisualStudioCode
# ──────────────────────────────────────────────

# ── 环境变量 & 密钥 ───────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.secret
.secrets/
secrets/

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual Environments ──────────────────────
.venv/
venv/
env/
ENV/
.env.bak
.venv.bak

# ── Testing ──────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
nosetests.xml
test-results/
test-reports/
*.log

# ── Type Checking ────────────────────────────
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ── IDE & Editor ─────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Jupyter ──────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Database ──────────────────────────────────
*.db
*.db.bak-*
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3
backend/data/
!data/.gitkeep

# ── Logs ─────────────────────────────────────
logs/
*.log
log/

# ── Runtime Data ──────────────────────────────
data/cache/
data/tmp/
data/processed/
backups/
!backups/.gitkeep

# ── Docker ────────────────────────────────────
.docker/

# ── Node.js (V2 前端) ─────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
next-env.d.ts
.npm-cache/
*.tsbuildinfo

# ── Build Artifacts ──────────────────────────
*.tar.gz
*.zip
*.deb
*.rpm

# ── Security Scan ─────────────────────────────
.bandit
.baseline
# .secrets.baseline should be committed (detect-secrets baseline)

# ── OS Generated ──────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ── Project Specific ──────────────────────────
# Local Git worktrees
.worktrees/

# 临时 local 开发数据
local_data/
tmp/
tmp-*
*.local

# Pytest coverage in CI
coverage.lcov
junit-*.xml
